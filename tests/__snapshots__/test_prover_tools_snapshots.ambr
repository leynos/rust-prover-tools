# serializer version: 1
# name: test_kani_exec_help_snapshot
  '''
  Usage: prover-tools kani exec --installation STR --cwd STR --extra-arg STR...
  
  Execute an already installed, qualified Kani 0.67 Linux release.
  
  ╭─ Parameters ─────────────────────────────────────────────────────────────────╮
  │ *  --installation STR   Literal release-root path text, containing bin and   │
  │                         toolchain directories. [env var: INPUT_INSTALLATION] │
  │                         [required]                                           │
  │ *  --cwd STR            Literal proof-directory path text; relative paths    │
  │                         use the process cwd. [env var: INPUT_CWD] [required] │
  │ *  --extra-arg STR...   Literal verifier arguments, provided with repeated   │
  │      --empty-extra-arg  --extra-arg options. [env var: INPUT_EXTRA_ARG]      │
  │                         [required]                                           │
  ╰──────────────────────────────────────────────────────────────────────────────╯
  
  '''
# ---
# name: test_kani_install_help_snapshot
  '''
  Usage: prover-tools kani install [OPTIONS]
  
  Install the pinned Kani verifier.
  
  ╭─ Parameters ─────────────────────────────────────────────────────────────────╮
  │ --repo-root PATH        Repository root used to resolve default tool pin     │
  │                         paths. [env var: INPUT_REPO_ROOT, INPUT_REPO_ROOT]   │
  │ --version-file PATH     Optional Kani version pin override. [env var:        │
  │                         INPUT_VERSION_FILE, INPUT_KANI_VERSION_FILE,         │
  │                         INPUT_VERSION_FILE]                                  │
  │ --version STR           Optional semantic version override. [env var:        │
  │                         INPUT_VERSION, INPUT_VERSION]                        │
  │ --setup --no-setup      Whether to run `cargo kani setup` after              │
  │                         installation. [env var: INPUT_SETUP] [default: True] │
  │ --verify --no-verify    Whether to run `cargo kani --version` after          │
  │                         installation. [env var: INPUT_VERIFY] [default:      │
  │                         True]                                                │
  │ --compile --no-compile  Whether to compile Kani from source instead of       │
  │                         installing the pinned                                │
  │                         prebuilt release. [env var: INPUT_KANI_COMPILE,      │
  │                         INPUT_COMPILE] [default: False]                      │
  │ --install-dir PATH      Directory for prebuilt Kani executables. Defaults to │
  │                         Cargo's binary                                       │
  │                         directory. [env var: KANI_INSTALL_DIR,               │
  │                         INPUT_KANI_INSTALL_DIR, INPUT_INSTALL_DIR]           │
  │ --cache-dir PATH        Directory for verified Kani archives. Defaults to    │
  │                         `.cache/kani` below                                  │
  │                         the repository root. [env var: KANI_CACHE_DIR,       │
  │                         INPUT_KANI_CACHE_DIR, INPUT_CACHE_DIR]               │
  ╰──────────────────────────────────────────────────────────────────────────────╯
  
  '''
# ---
# name: test_kani_run_help_snapshot
  '''
  Usage: prover-tools kani run --snapshot-pin PATH [OPTIONS] [ARGS...]
  
  Run a proof through the exact installed snapshot. Place -- before verifier 
  arguments.
  
  ╭─ Arguments ──────────────────────────────────────────────────────────────────╮
  │ ARGS                                                                         │
  ╰──────────────────────────────────────────────────────────────────────────────╯
  ╭─ Parameters ─────────────────────────────────────────────────────────────────╮
  │ *  --snapshot-pin PATH  Required reviewed pin for this proof. [required]     │
  │    --repo-root PATH     Repository root; also the proof working directory.   │
  │    --cache-dir PATH     Snapshot cache. Defaults to `.kani-snapshots`.       │
  ╰──────────────────────────────────────────────────────────────────────────────╯
  
  '''
# ---
# name: test_kani_snapshot_help_snapshot
  '''
  Usage: prover-tools kani snapshot COMMAND
  
  Install and check one immutable Kani snapshot
  
  ╭─ Commands ───────────────────────────────────────────────────────────────────╮
  │ check    Check that the active generation still matches its reviewed pin.    │
  │ install  Install a reviewed snapshot from a local verified asset directory.  │
  ╰──────────────────────────────────────────────────────────────────────────────╯
  
  '''
# ---
# name: test_kani_snapshot_install_help_snapshot
  '''
  Usage: prover-tools kani snapshot install [OPTIONS]
  
  Install a reviewed snapshot from a local verified asset directory.
  
  ╭─ Parameters ─────────────────────────────────────────────────────────────────╮
  │ --pin PATH        Reviewed pin. Defaults to `tools/kani/snapshot.toml`.      │
  │ --repo-root PATH  Repository root used for default paths.                    │
  │ --cache-dir PATH  Snapshot cache. Defaults to `.kani-snapshots`.             │
  │ --asset-dir PATH  Directory holding the release files and their attestation  │
  │                   bundle.                                                    │
  ╰──────────────────────────────────────────────────────────────────────────────╯
  
  '''
# ---
# name: test_top_level_help_snapshot
  '''
  Usage: prover-tools COMMAND
  
  ╭─ Commands ───────────────────────────────────────────────────────────────────╮
  │ kani         Manage Kani verifier installation and version checking          │
  │ verus        Manage Verus verifier installation and proof execution          │
  │ z3           Install the pinned Z3 solver used by Verus                      │
  │ --help (-h)  Display this message and exit.                                  │
  │ --version    Display application version.                                    │
  ╰──────────────────────────────────────────────────────────────────────────────╯
  
  '''
# ---
# name: test_z3_install_help_snapshot
  '''
  Usage: prover-tools z3 install [OPTIONS]
  
  Install the pinned Z3 solver used by Verus.
  
  ╭─ Parameters ─────────────────────────────────────────────────────────────────╮
  │ --repo-root PATH    Repository root used to resolve default install paths.   │
  │                     [env var: INPUT_REPO_ROOT, INPUT_REPO_ROOT]              │
  │ --install-dir PATH  Directory for the `z3` binary. Defaults to               │
  │                     `.cache/z3/<version>` below                              │
  │                     the repository root. [env var: Z3_INSTALL_DIR,           │
  │                     INPUT_Z3_INSTALL_DIR, INPUT_INSTALL_DIR]                 │
  │ --cache-dir PATH    Directory for verified Z3 archives. Defaults to          │
  │                     `.cache/z3` below the                                    │
  │                     repository root. [env var: Z3_CACHE_DIR,                 │
  │                     INPUT_Z3_CACHE_DIR, INPUT_CACHE_DIR]                     │
  ╰──────────────────────────────────────────────────────────────────────────────╯
  
  '''
